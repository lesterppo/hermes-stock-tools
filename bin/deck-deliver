#!/usr/bin/env python3
"""deck-deliver — Generate + inline + verify a stock research slide deck.
Usage:
  deck-deliver spec.json                    # Generate from spec, inline, verify
  deck-deliver spec.json output.html         # Custom output path
  deck-deliver --from-fin KEYS              # Auto-generate from fin data, then inline

Runs: deck-gen → html-inline → reports final file path + size.
"""

import sys, subprocess, os
from pathlib import Path

HTML_INLINE = os.path.expanduser("~/.local/bin/html-inline")
DECK_GEN = os.path.expanduser("~/.local/bin/deck-gen")

def deliver(input_spec, output_path=None, skip_gen=False):
    # Step 1: Generate (skip if already generated by --from-fin)
    if not skip_gen:
        out = output_path or input_spec.replace('.json', '.html')
        result = subprocess.run(
            [DECK_GEN, input_spec, out],
            capture_output=True, text=True, timeout=30
        )
        if result.returncode != 0:
            print(f"Error (deck-gen): {result.stderr}", file=sys.stderr)
            return 1
        output_path = out
    
    if not output_path or not Path(output_path).exists():
        print(f"Error: No output file generated", file=sys.stderr)
        return 1
    
    # Step 2: Inline assets for offline delivery
    result = subprocess.run(
        [HTML_INLINE, output_path],
        capture_output=True, text=True, timeout=15
    )
    if result.returncode != 0:
        print(f"Warning: html-inline failed: {result.stderr}", file=sys.stderr)
    
    # Step 3: Report
    size = Path(output_path).stat().st_size
    size_str = f"{size/1024:.0f}KB" if size > 1024 else f"{size}B"
    print(f"✅ {output_path} ({size_str}, fully offline)")
    return 0

if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    
    if sys.argv[1] == "--from-fin":
        symbol = sys.argv[2]
        out = sys.argv[3] if len(sys.argv) > 3 else str(Path.home() / "research" / f"{symbol.lower()}-deck.html")
        result = subprocess.run(
            [DECK_GEN, "--from-fin", symbol, out],
            capture_output=True, text=True, timeout=30
        )
        if result.returncode != 0:
            print(f"Error: {result.stderr}", file=sys.stderr)
            sys.exit(1)
        
        # Strip placeholder slides from the raw deck-gen output
        html = Path(out).read_text()
        import re
        # Remove slides that are empty placeholders
        html = re.sub(r'<div class="slide".*?data-index="\d+">\s*</div>', '', html, flags=re.DOTALL)
        Path(out).write_text(html)
        
        sys.exit(deliver(None, out, skip_gen=True))
    
    spec_file = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) > 2 else spec_file.replace('.json', '.html')
    sys.exit(deliver(spec_file, output_file))
