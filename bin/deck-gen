if __name__ == "__main__":
    if len(sys.argv) < 2:
        print(__doc__)
        sys.exit(1)
    
    if sys.argv[1] == "--template":
        print_template()
        sys.exit(0)
    
    if sys.argv[1] == "--from-fin":
        # Auto-generate from fin data
        symbol = sys.argv[2]
        output = sys.argv[3] if len(sys.argv) > 3 else str(Path.home() / "research" / f"{symbol.lower()}-deck.html")
        
        import subprocess
        r1 = subprocess.run(['fin', symbol, 'json'], capture_output=True, text=True)
        r2 = subprocess.run(['fin', symbol, 'chart'], capture_output=True, text=True)
        data = json.loads(r1.stdout)
        charts = json.loads(r2.stdout)
        data['_charts'] = charts.get('charts',{})
        
        # Build minimal spec from fin data
        price = data.get('currentPrice','---')
        mc = data.get('marketCap')
        mcap_str = f"${mc/1e9:.1f}B" if mc else ''
        name = data.get('longName','') or data.get('shortName',symbol)
        pe_t = data.get('trailingPE')
        pe_f = data.get('forwardPE')
        
        rev_annual = data['_charts'].get('revenue_annual',{})
        
        spec = {
            "symbol": symbol,
            "title": f"{name} — Deep Dive Investment Research",
            "data": data,
            "slides": [
                {"type": "title", "symbol": symbol, "name": name, "price": price, "market_cap": mcap_str, "subtitle": "Investment Research & Deep Dive", "meta": f"Forward P/E: {pe_f:.1f}x" if pe_f else ""},
                {"type": "exec-summary", "bull": "[Add bull case from research]", "bear": "[Add risk considerations from research]", "stats": [{"value": mcap_str, "label": "Market Cap"}, {"value": f"{data.get('revenueGrowth',0)*100:+.0f}%" if data.get('revenueGrowth') else "---", "label": "Rev Growth"}, {"value": f"${data.get('targetMeanPrice',0):.0f}" if data.get('targetMeanPrice') else "---", "label": "Target"}]},
            ]
        }
        
        if rev_annual.get('labels'):
            spec["slides"].append({
                "type": "revenue", "chart_data": rev_annual, "stats": [
                    {"value": f"${rev_annual['data'][0]}B" if rev_annual['data'] else "", "label": rev_annual['labels'][0] if rev_annual['labels'] else "FY"},
                    {"value": f"${rev_annual['data'][-1]}B" if rev_annual['data'] else "", "label": rev_annual['labels'][-1] if rev_annual['labels'] else "FY"}
                ], "highlight": "[Add revenue narrative]"
            })
        
        # Generate placeholder slides for remaining content
        for i, stype in enumerate(['company','segments','margins','balance','stock','analysts','industry','catalyst','catalyst2','risks','thesis']):
            if stype == 'revenue':
                continue
            spec["slides"].append({"type": stype, "placeholder": True, "_note": f"Replace with real data from research"})
        
        html = generate(spec)
        
        # Strip placeholder slides
        import re
        html = re.sub(r'<div class="slide".*?placeholder.*?</div>\s*</div>', '', html, flags=re.DOTALL)
        
        Path(output).write_text(html)
        print(f"Generated: {output} ({len(html):,} bytes)")
        print("NOTE: Placeholder slides removed. Fill in research data in spec and re-run.")
        sys.exit(0)
    
    spec_file = sys.argv[1]
    output_file = sys.argv[2] if len(sys.argv) > 2 else spec_file.replace('.json','.html')
    
    spec = json.loads(Path(spec_file).read_text())
    html = generate(spec)
    Path(output_file).write_text(html)
    print(f"Generated: {output_file} ({len(html):,} bytes)")
