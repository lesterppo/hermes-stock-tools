#!/usr/bin/env python3
"""deck-gen — Generate professional stock research HTML slide decks from JSON specs.
Usage:
  deck-gen spec.json output.html          # Generate from spec file
  deck-gen --from-fin KEYS output.html    # Auto-generate from fin data + inline research
  deck-gen --template > blank-spec.json   # Print template spec

Spec format: see --template output.
Integrates with `fin json` and `fin chart` for auto-populated charts.
Automatically inlines Chart.js + Font Awesome for offline delivery.
"""

import json, sys, os
from pathlib import Path
from datetime import datetime

