JS_NAV = """<script>
var cs=0,ts=__SLIDE_COUNT__,els=null,ctr=null,pd=null,ci={};
function goTo(n){els[cs].classList.remove('active');cs=n;els[cs].classList.add('active');if(ctr)ctr.textContent='Slide '+(cs+1)+' / '+ts;updateDots();renderCharts(cs);}
window.prevSlide=function(){goTo((cs-1+ts)%ts);};window.nextSlide=function(){goTo((cs+1)%ts);};
function buildDots(){pd=document.getElementById('progressDots');pd.innerHTML='';for(var i=0;i<ts;i++){var d=document.createElement('button');d.className='dot'+(i===0?' active':'');d.setAttribute('aria-label','Go to slide '+(i+1));d.onclick=(function(idx){return function(){goTo(idx);};})(i);pd.appendChild(d);}}
function updateDots(){var dots=pd.querySelectorAll('.dot');for(var i=0;i<dots.length;i++)dots[i].className='dot'+(i===cs?' active':'');}
document.addEventListener('keydown',function(e){if(e.key==='ArrowRight'||e.key==='ArrowDown'||e.key===' '){e.preventDefault();window.nextSlide();}else if(e.key==='ArrowLeft'||e.key==='ArrowUp'){e.preventDefault();window.prevSlide();}});
var tx=0;document.addEventListener('touchstart',function(e){tx=e.changedTouches[0].screenX;},{passive:true});document.addEventListener('touchend',function(e){var dx=e.changedTouches[0].screenX-tx;if(Math.abs(dx)>50){if(dx<0)window.nextSlide();else window.prevSlide();}},{passive:true});
function renderCharts(si){__CHART_TRIGGERS__}
function tryDraw(key,cid,fn){if(ci[key]){try{ci[key].resize();}catch(e){}return;}if(typeof Chart==='undefined')return;var c=document.getElementById(cid);if(!c)return;c.style.display='block';try{ci[key]=fn(c);}catch(e){console.error('Chart render failed:',e);}}
__CHART_FUNCTIONS__
function init(){els=document.querySelectorAll('.slide');ctr=document.getElementById('slideCounter');buildDots();}
if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
</script>"""

def h(s): return s.replace('&','&amp;').replace('<','&lt;').replace('>','&gt;').replace('"','&quot;')

def render_title(spec, data):
    d = data or {}
    sym = spec.get('symbol','N/A')
    name = spec.get('name', d.get('longName',''))
    price = spec.get('price', d.get('currentPrice','---'))
    mcap = spec.get('market_cap', '')
    if not mcap and d.get('marketCap'):
        mc = d['marketCap']
        mcap = f"${mc/1e9:.1f}B" if mc else ''
    meta_parts = [f"Price: ${price:.2f}" if isinstance(price,(int,float)) else f"Price: {price}"]
    if mcap: meta_parts.append(f"Market Cap: {mcap}")
    meta_parts.append(spec.get('meta',''))

    return f"""<div class="slide active title-slide" data-index="0">
  <div class="ticker">{h(sym)}</div>
  <h1>{h(name)}</h1>
  <div class="sub">{h(spec.get('subtitle','Comprehensive Investment Research & Deep Dive'))}</div>
  <div class="meta">{h(spec.get('date',datetime.now().strftime('%B %d, %Y')))} &nbsp;|&nbsp; {' &nbsp;|&nbsp; '.join(meta_parts)}</div>
</div>"""

def render_exec_summary(spec, data):
    stats = spec.get('stats',[])
    stat_html = '\n'.join(f'<div class="stat-box"><div class="stat-value" style="color:{s.get("color","var(--accent)")}">{h(str(s["value"]))}</div><div class="stat-label">{h(s["label"])}</div></div>' for s in stats)
    return f"""<div class="slide" data-index="1">
  <div class="slide-title">Executive Summary</div>
  <div class="two-col" style="flex:1">
    <div class="card"><h3>The Bull Case</h3><p>{h(spec.get('bull',''))}</p>{spec.get('bull_highlight','')}</div>
    <div class="card"><h3>Key Considerations</h3><p>{h(spec.get('bear',''))}</p><div class="stat-grid" style="margin-top:16px;grid-template-columns:repeat({len(stats)},1fr)">{stat_html}</div></div>
  </div>
</div>"""

def render_company(spec, data):
    rows = '\n'.join(f'<tr><td style="color:var(--accent);width:140px">{h(r[0])}</td><td>{h(str(r[1]))}</td></tr>' for r in spec.get('profile',[]))
    acq_rows = '\n'.join(f'<tr><td>{h(a[0])}</td><td>{h(str(a[1]))}</td><td>{h(a[2])}</td></tr>' for a in spec.get('acquisitions',[]))
    return f"""<div class="slide" data-index="2">
  <div class="slide-title">Company Overview</div>
  <div class="two-col" style="flex:1">
    <div><div class="card" style="margin-bottom:20px"><h3>Corporate Profile</h3><table>{rows}</table></div><div class="card"><h3>What {h(spec.get('symbol',''))} Does</h3><p style="font-size:0.9rem">{h(spec.get('description',''))}</p></div></div>
    <div class="card" style="display:flex;flex-direction:column"><h3>Strategic Acquisitions</h3><table><tr><th>Target</th><th>Value</th><th>Strategic Fit</th></tr>{acq_rows}</table>{spec.get('acq_note','')}</div>
  </div>
</div>"""

def render_segments(spec, data):
    seg_data = spec.get('chart',[50,50])
    seg_labels = spec.get('chart_labels',['Segment A','Segment B'])
    seg_colors = spec.get('chart_colors',['#38bdf8','#818cf8'])
    seg1 = spec.get('segment1',{})
    seg2 = spec.get('segment2',{})
    chart_id = 'chartSegments'
    chart_fn = f'c{chart_id}'
    
    stat1_val = seg1.get('value','')
    stat2_val = seg2.get('value','')
    
    chart_trigger = f"if(si===3)tryDraw('seg','{chart_id}',{chart_fn});"
    chart_func = f"function {chart_fn}(c){{return new Chart(c,{{type:'doughnut',data:{{labels:{json.dumps(seg_labels)},datasets:[{{data:{json.dumps(seg_data)},backgroundColor:{json.dumps(seg_colors)},borderColor:'#111827',borderWidth:3}}]}},options:{{responsive:true,maintainAspectRatio:false,plugins:{{legend:{{position:'bottom',labels:{{color:'#94a3b8',padding:16,font:{{size:13}}}}}}}}}}}})}}}}}}"
    
    return {
        'html': f"""<div class="slide" data-index="3">
  <div class="slide-title">Business Segments</div>
  <div class="two-col" style="flex:1">
    <div class="card" style="display:flex;flex-direction:column"><h3>Revenue Split</h3><div class="chart-container"><canvas id="{chart_id}" style="display:none"></canvas></div><div style="display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px"><div class="stat-box"><div class="stat-value" style="color:{seg_colors[0]};font-size:1.5rem">{h(str(seg1.get('pct','?')))}%</div><div class="stat-label">{h(seg1.get('name','Segment 1'))}<br>{h(str(stat1_val))}</div></div><div class="stat-box"><div class="stat-value" style="color:{seg_colors[1]};font-size:1.5rem">{h(str(seg2.get('pct','?')))}%</div><div class="stat-label">{h(seg2.get('name','Segment 2'))}<br>{h(str(stat2_val))}</div></div></div></div>
    <div><div class="card" style="margin-bottom:20px"><h3>{h(seg1.get('name','Segment 1'))}</h3><ul>{''.join(f'<li>{h(item)}</li>' for item in seg1.get('details',[]))}</ul></div><div class="card"><h3>{h(seg2.get('name','Segment 2'))}</h3><ul>{''.join(f'<li>{h(item)}</li>' for item in seg2.get('details',[]))}</ul></div></div>
  </div>
</div>""",
        'chart_trigger': chart_trigger,
        'chart_func': chart_func
    }

def render_revenue(spec, data):
    chart_data = spec.get('chart_data', {})
    labels = json.dumps(chart_data.get('labels',[]))
    values = json.dumps(chart_data.get('data',[]))
    unit = chart_data.get('unit','B')
    stats = '\n'.join(f'<div class="stat-box"><div class="stat-value" style="color:{s.get("color","var(--accent)")}">{h(str(s["value"]))}</div><div class="stat-label">{h(s["label"])}</div>{("<div class=\"stat-change "+s.get("change_dir","")+"\">"+h(str(s.get("change","")))+"</div>") if s.get("change") else ""}</div>' for s in spec.get('stats',[]))
    
    chart_id = 'chartRevenue'
    chart_fn = f'c{chart_id}'
    bg_colors = json.dumps(chart_data.get('colors',['rgba(56,189,248,0.5)' for _ in chart_data.get('data',[])]))
    
    chart_trigger = f"if(si===4)tryDraw('rev','{chart_id}',{chart_fn});"
    chart_func = f"function {chart_fn}(c){{return new Chart(c,{{type:'bar',data:{{labels:{labels},datasets:[{{label:'Revenue (${unit})',data:{values},backgroundColor:{bg_colors},borderColor:'#38bdf8',borderWidth:1,borderRadius:4}}]}},options:{{responsive:true,maintainAspectRatio:false,plugins:{{legend:{{display:false}}}},scales:{{y:{{grid:{{color:'rgba(148,163,184,0.1)'}},ticks:{{color:'#94a3b8',callback:function(v){{return '$'+v+'{unit}'}}}}}},x:{{ticks:{{color:'#94a3b8'}}}}}}}});}}"
    
    return {
        'html': f"""<div class="slide" data-index="4">
  <div class="slide-title">Revenue Growth</div>
  <div class="stat-grid" style="grid-template-columns:repeat({len(spec.get('stats',[]))},1fr)">{stats}</div>
  <div class="card" style="margin-bottom:20px"><div class="chart-container" style="height:320px"><canvas id="{chart_id}" style="display:none"></canvas></div></div>
  <div class="highlight"><p>{h(spec.get('highlight',''))}</p></div>
</div>""",
        'chart_trigger': chart_trigger,
        'chart_func': chart_func
    }

def render_margins(spec, data):
    eps_data = spec.get('eps_chart',{})
    labels = json.dumps(eps_data.get('labels',[]))
    values = json.dumps(eps_data.get('data',[]))
    
    def _metric_row(r):
        base = f'<tr><td style="color:var(--accent)">{h(r[0])}</td><td>{h(str(r[1]))}'
        if len(r) > 2:
            base += f' <span class="badge badge-green">{h(r[2])}</span>'
        return base + '</td></tr>'
    rows = '\n'.join(_metric_row(r) for r in spec.get('metrics',[]))
    
    chart_id = 'chartEPS'
    chart_fn = f'c{chart_id}'
    bg_colors = json.dumps(eps_data.get('colors',['rgba(56,189,248,0.6)' for _ in eps_data.get('data',[])]))
    
    chart_trigger = f"if(si===5)tryDraw('eps','{chart_id}',{chart_fn});"
    chart_func = f"function {chart_fn}(c){{return new Chart(c,{{type:'bar',data:{{labels:{labels},datasets:[{{label:'EPS',data:{values},backgroundColor:{bg_colors},borderColor:'#38bdf8',borderWidth:1,borderRadius:4}}]}},options:{{responsive:true,maintainAspectRatio:false,plugins:{{legend:{{display:false}}}},scales:{{y:{{grid:{{color:'rgba(148,163,184,0.1)'}},ticks:{{color:'#94a3b8',callback:function(v){{return '$'+v}}}}}},x:{{ticks:{{color:'#94a3b8'}}}}}}}});}}"
    
    return {
        'html': f"""<div class="slide" data-index="5">
  <div class="slide-title">Margin Expansion & Earnings Power</div>
  <div class="two-col" style="flex:1">
    <div class="card" style="display:flex;flex-direction:column"><h3>EPS Trajectory</h3><div class="chart-container"><canvas id="{chart_id}" style="display:none"></canvas></div></div>
    <div><div class="card" style="margin-bottom:20px"><h3>Profitability Metrics</h3><table>{rows}</table></div>{spec.get('extra_card','')}</div>
  </div>
</div>""",
        'chart_trigger': chart_trigger,
        'chart_func': chart_func
    }

def render_balance(spec, data):
    rows = '\n'.join(f'<tr><td style="color:var(--accent)">{h(r[0])}</td><td>{h(str(r[1]))}</td></tr>' for r in spec.get('metrics',[]))
    items = '\n'.join(f'<li>{h(item)}</li>' for item in spec.get('items',[]))
    return f"""<div class="slide" data-index="6">
  <div class="slide-title">Balance Sheet & Capital Allocation</div>
  <div class="two-col" style="flex:1">
    <div><div class="card" style="margin-bottom:20px"><h3>Financial Position</h3><table>{rows}</table></div><div class="card"><h3>Capital Allocation</h3><ul>{items}</ul></div></div>
    <div class="card"><p>{h(spec.get('narrative',''))}</p>{spec.get('highlight','')}{spec.get('extra','')}</div>
  </div>
</div>"""

def render_stock(spec, data):
    def _val_row(r):
        base = f'<tr><td style="color:var(--accent)">{h(r[0])}</td><td>{h(str(r[1]))}'
        if len(r) > 2:
            base += f' <span class="badge badge-green">{h(r[2])}</span>'
        return base + '</td></tr>'
    v_rows = '\n'.join(_val_row(r) for r in spec.get('valuation',[]))
    h_rows = '\n'.join(f'<tr><td>{h(r[0])}</td><td>{h(str(r[1]))}</td></tr>' for r in spec.get('holders',[]))
    stats_html = '\n'.join(f'<div class="stat-box"><div class="stat-value" style="color:{s.get("color","var(--accent)")}">{h(str(s["value"]))}</div><div class="stat-label">{h(s["label"])}</div></div>' for s in spec.get('stats',[]))
    return f"""<div class="slide" data-index="7">
  <div class="slide-title">Stock Performance & Valuation</div>
  <div class="stat-grid" style="grid-template-columns:repeat({len(spec.get('stats',[]))},1fr)">{stats_html}</div>
  <div class="two-col" style="flex:1;margin-top:16px">
    <div class="card" style="display:flex;flex-direction:column"><h3>Valuation Metrics</h3><table>{v_rows}</table></div>
    <div class="card"><h3>Institutional Backing</h3><div style="font-size:2.5rem;color:var(--accent);font-weight:900;margin-bottom:4px">{h(str(spec.get('inst_ownership','')))}</div><div style="color:var(--text-secondary);margin-bottom:16px">Institutional Ownership</div><table><tr><th>Top Holders</th><th>% Owned</th></tr>{h_rows}</table>{spec.get('note','')}</div>
  </div>
</div>"""

def render_analysts(spec, data):
    p_rows = '\n'.join(f'<tr><td style="color:var(--accent)">{h(r[0])}</td><td>{h(str(r[1]))}</td></tr>' for r in spec.get('peer_rows',[]))
    return f"""<div class="slide" data-index="8">
  <div class="slide-title">Analyst Coverage & Peer Comparison</div>
  <div class="two-col" style="flex:1">
    <div><div class="card" style="margin-bottom:20px;text-align:center"><h3>Consensus</h3><div style="font-size:3rem;color:var(--accent);font-weight:900">{h(str(spec.get('target','')))}</div><div style="color:var(--text-secondary)">{h(spec.get('target_desc',''))}</div><div style="margin-top:12px"><span class="badge badge-green" style="font-size:0.95rem;padding:6px 16px">{h(str(spec.get('analyst_info','')))}</span></div></div>{spec.get('extra_left','')}</div>
    <div class="card"><h3>Peer Comparison</h3><table><tr><th>Ticker</th><th>Company</th><th>Trail P/E</th><th>Fwd P/E</th><th>PEG</th></tr>{p_rows}</table>{spec.get('peer_note','')}</div>
  </div>
</div>"""

def render_industry(spec, data):
    c_rows = '\n'.join(f'<tr>{("<td style=\"color:var(--accent)\"><strong>"+h(r[0])+"</strong></td>") if i==0 else ""}<td>{h(r[1])}</td><td>{h(str(r[2]))}</td><td>{h(r[3])}</td></tr>' for i,r in enumerate(spec.get('competitors',[])))
    items = '\n'.join(f'<li>{h(item)}</li>' for item in spec.get('moat_points',[]))
    return f"""<div class="slide" data-index="9">
  <div class="slide-title">Industry & Competitive Moat</div>
  <div class="two-col" style="flex:1">
    <div><div class="card" style="margin-bottom:20px"><h3>{h(spec.get('market_title',''))}</h3><div style="font-size:2rem;color:var(--accent);font-weight:800;margin-bottom:4px">{h(spec.get('market_position',''))}</div><div style="color:var(--text-secondary)">{h(spec.get('market_detail',''))}</div><p style="margin-top:12px">{h(spec.get('market_note',''))}</p></div><div class="card"><h3>{h(spec.get('moat_title',''))}</h3><ul>{items}</ul></div></div>
    <div class="card"><h3>Key Competitors</h3><table><tr><th>Competitor</th><th>HQ</th><th>Est. Revenue</th><th>Focus</th></tr>{c_rows}</table>{spec.get('competitor_note','')}</div>
  </div>
</div>"""

def render_catalyst(spec, data):
    stats_html = '\n'.join(
        f'<div class="stat-box"><div class="stat-value" style="color:{s.get("color","var(--accent)")};font-size:1.3rem">{h(str(s["value"]))}</div><div class="stat-label">{h(s["label"])}</div></div>'
        for s in spec.get('stats',[])
    )
    items = '\n'.join(f'<li>{h(item)}</li>' for item in spec.get('points',[]))
    rows = '\n'.join(f'<tr><td>{h(r[0])}</td><td>{h(str(r[1]))}</td><td>{h(r[2])}</td></tr>' for r in spec.get('timeline',[]))
    
    return f"""<div class="slide" data-index="10">
  <div class="slide-title">Growth Catalyst: {h(spec.get('catalyst_name',''))}</div>
  <div class="stat-grid" style="grid-template-columns:repeat({len(spec.get('stats',[]))},1fr)">{stats_html}</div>
  <div class="two-col" style="flex:1">
    <div class="card"><h3>Why {h(spec.get('symbol',''))} Wins</h3><ul>{items}</ul></div>
    <div><div class="card" style="margin-bottom:16px"><h3>Demand Trajectory</h3><table><tr><th>Period</th><th>Performance</th><th>Context</th></tr>{rows}</table></div>{spec.get('risk_note','')}</div>
  </div>
</div>"""

def render_catalyst2(spec, data):
    parts = ''.join(f'<div class="card" style="margin-bottom:20px"><h3>{h(c.get("title",""))}</h3><ul>{"".join(f"<li>{h(item)}</li>" for item in c.get("points",[]))}</ul></div>' for c in spec.get('columns',[]))
    return f"""<div class="slide" data-index="11">
  <div class="slide-title">{h(spec.get('title','Growth Catalyst'))}</div>
  <div class="two-col" style="flex:1">
    <div>{parts[:len(parts)//2] if len(spec.get('columns',[]))>2 else parts}</div>
    <div>{parts[len(parts)//2:] if len(spec.get('columns',[]))>2 else ''}</div>
  </div>
</div>"""

def render_risks(spec, data):
    cards = ''.join(f'<div class="card"><h3 style="color:var(--red)">{h(r.get("title",""))}</h3><ul>{"".join(f"<li>{h(item)}</li>" for item in r.get("points",[]))}</ul></div>' for r in spec.get('risk_cards',[]))
    return f"""<div class="slide" data-index="12">
  <div class="slide-title">Risk Factors & Watch Items</div>
  <div class="three-col" style="flex:1">{cards}</div>
  {spec.get('footer','')}
</div>"""

def render_thesis(spec, data):
    bull_items = '\n'.join(f'<li>{h(item)}</li>' for item in spec.get('bull_points',[]))
    bear_items = '\n'.join(f'<li>{h(item)}</li>' for item in spec.get('bear_points',[]))
    return f"""<div class="slide" data-index="13">
  <div class="slide-title">Investment Thesis & Outlook</div>
  <div class="bull-bear" style="flex:1">
    <div class="bull-card"><h3>The Bull Case</h3><ul style="margin-top:12px">{bull_items}</ul></div>
    <div class="bear-card"><h3>The Bear Case</h3><ul style="margin-top:12px">{bear_items}</ul></div>
  </div>
  {spec.get('bottom_line','')}
</div>"""

RENDERERS = {
    'title': render_title,
    'exec-summary': render_exec_summary,
    'company': render_company,
    'segments': render_segments,
    'revenue': render_revenue,
    'margins': render_margins,
    'balance': render_balance,
    'stock': render_stock,
    'analysts': render_analysts,
    'industry': render_industry,
    'catalyst': render_catalyst,
    'catalyst2': render_catalyst2,
    'risks': render_risks,
    'thesis': render_thesis,
}

def generate(spec):
    data = spec.get('data',{})
    slides_html = []
    chart_triggers = []
    chart_functions = []
    
    for slide in spec.get('slides',[]):
        stype = slide.get('type','')
        renderer = RENDERERS.get(stype)
        if not renderer:
            continue
        
        result = renderer(slide, data)
        if isinstance(result, dict):
            slides_html.append(result['html'])
            if result.get('chart_trigger'):
                chart_triggers.append(result['chart_trigger'])
            if result.get('chart_func'):
                chart_functions.append(result['chart_func'])
        else:
            slides_html.append(result)
    
    slide_count = len(slides_html)
    nav_js = JS_NAV.replace('__SLIDE_COUNT__', str(slide_count))
    nav_js = nav_js.replace('__CHART_TRIGGERS__', '\n  '.join(chart_triggers))
    nav_js = nav_js.replace('__CHART_FUNCTIONS__', '\n'.join(chart_functions))
    
    return f"""<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{h(spec.get('title',spec.get('symbol','Stock')+' — Deep Dive Investment Research'))}</title>
<style>{DARK_THEME_CSS}</style>
</head>
<body>
<div class="presentation">
{chr(10).join(slides_html)}
</div>
<div class="nav-bar">
  <button onclick="prevSlide()">Previous</button>
  <div class="progress-dots" id="progressDots"></div>
  <span class="counter" id="slideCounter">Slide 1 / {slide_count}</span>
  <button onclick="nextSlide()">Next</button>
</div>
{nav_js}
</body>
</html>"""

def print_template():
